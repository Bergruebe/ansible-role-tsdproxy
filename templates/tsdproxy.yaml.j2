defaultProxyProvider: default
docker:
  local: # name of the docker provider
    host: {{ tsdproxy_docker_endpoint }} # host of the docker socket or daemon
    targetHostname: {{ tsdproxy_docker_target_hostname }} # hostname or IP of docker server
    defaultProxyProvider: default # name of which proxy provider to use

lists: {{ tsdproxy_config_lists }}

tailscale:
  providers:
    default: # Name of the Tailscale provider
      clientId: {{ tsdproxy_tailscale_clientid }} # OAuth client ID (generated by Tailscale)
      clientSecret: {{ tsdproxy_tailscale_clientsecret }}

      # authKey is only used if no ClientId or authKeyFile is defined
      authKey: {{ tsdproxy_tailscale_authkey }} # Tailscale auth key (alternative to OAuth)
      authKeyFile: {{ tsdproxy_tailscale_authkeyfile }} # Path to a file containing the auth key (ignores authKey if defined)

      tags: {{ tsdproxy_tailscale_tags }}
      controlUrl: {{ tsdproxy_controlurl }} # Override the default Tailscale control URL
      preventDuplicates: {{ tsdproxy_tailscale_prevent_duplicates }}
      maxCertConcurrency: {{ tsdproxy_tailscale_max_cert_concurrency }}


    {{ tsdproxy_additional_providers }}
  dataDir: /data/
http:
  hostname: 0.0.0.0
  port: {{ tsdproxy_container_http_port }}
log:
  level: {{ tsdproxy_loglevel }} # set logging level info, error or trace
  json: {{ tsdproxy_log_json }} # set to true to enable json logging
proxyAccessLog: {{ tsdproxy_proxyaccesslog }} # set to true to enable container access log

{{ tsdproxy_extra_config }}
